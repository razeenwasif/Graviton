<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Hardened runtime with no exceptions. Not sandboxed yet: the app talks to
	     gravitond's socket in ~/Library/Application Support (see the README). -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>$(TeamIdentifierPrefix)group.dev.graviton.shared</string>
	</array>
</dict>
</plist>
